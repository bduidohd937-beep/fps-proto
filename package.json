{
  "name": "project-duel",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run check:architecture && npm run test && npm run build",
    "test:e2e": "playwright test",
    "check:architecture": "node scripts/check-architecture.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.1.2",
    "@react-three/drei": "^10.0.6",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "vite": "^6.3.3",
    "@playwright/test": "^1.55.0"
  },
  "engines": {
    "node": ">=20"
  }
}
